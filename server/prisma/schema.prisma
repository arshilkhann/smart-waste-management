
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -------------------------
// ENUMS
// -------------------------

enum UserRole {
  CITIZEN
  ADMIN
  SUPERVISOR
  DRIVER
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  PENDING_VERIFICATION
  RESOLVED
  REJECTED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VehicleType {
  GARBAGE_TRUCK
  COMPACTOR
  E_RICKSHAW
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  INACTIVE
}

// -------------------------
// USER
// -------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String
  email        String   @unique
  passwordHash String
  phone        String?  @unique
  role         UserRole @default(CITIZEN)
  isActive     Boolean  @default(true)

  driverProfile DriverProfile?

  createdComplaints  Complaint[] @relation("CreatedComplaints")
  assignedComplaints Complaint[] @relation("AssignedComplaints")
  complaintHistory   ComplaintStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------
// WARD
// -------------------------

model Ward {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  wardCode  String   @unique

  areas     Area[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------
// AREA
// -------------------------

model Area {
  id       String @id @default(uuid()) @db.Uuid
  name     String

  wardId   String @db.Uuid
  ward     Ward   @relation(fields: [wardId], references: [id], onDelete: Restrict)

  complaints Complaint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, wardId])
  @@index([wardId])
}

// -------------------------
// WASTE TYPE
// -------------------------

model WasteType {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique
  description String?

  complaints Complaint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------
// DRIVER PROFILE
// -------------------------

model DriverProfile {
  id            String @id @default(uuid()) @db.Uuid
  licenseNumber String @unique

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicle Vehicle?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------
// VEHICLE
// -------------------------

model Vehicle {
  id                String        @id @default(uuid()) @db.Uuid
  registrationNumber String       @unique
  vehicleType       VehicleType
  status            VehicleStatus @default(AVAILABLE)
  capacity          Float?

  driverProfileId String?        @unique @db.Uuid
  driverProfile   DriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------
// COMPLAINT
// -------------------------

model Complaint {
  id          String            @id @default(uuid()) @db.Uuid
  title       String
  description String
  address     String

  latitude  Float?
  longitude Float?
  imageUrl  String?

  status   ComplaintStatus   @default(SUBMITTED)
  priority ComplaintPriority @default(MEDIUM)

  createdById String @db.Uuid
  createdBy   User   @relation("CreatedComplaints", fields: [createdById], references: [id], onDelete: Restrict)

  assignedToId String? @db.Uuid
  assignedTo   User?   @relation("AssignedComplaints", fields: [assignedToId], references: [id], onDelete: SetNull)

  areaId String @db.Uuid
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Restrict)

  wasteTypeId String    @db.Uuid
  wasteType   WasteType @relation(fields: [wasteTypeId], references: [id], onDelete: Restrict)

  statusHistory ComplaintStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([assignedToId])
  @@index([areaId])
  @@index([wasteTypeId])
}

// -------------------------
// COMPLAINT STATUS HISTORY
// -------------------------

model ComplaintStatusHistory {
  id String @id @default(uuid()) @db.Uuid

  complaintId String    @db.Uuid
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  previousStatus ComplaintStatus?
  newStatus      ComplaintStatus
  note           String?

  changedById String @db.Uuid
  changedBy   User   @relation(fields: [changedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([complaintId])
  @@index([changedById])
}
